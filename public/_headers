# Security headers for Cloudflare Pages. This file is copied verbatim into dist/ at build time and
# read by Pages; it does nothing in `astro dev`, so headers only apply to the deployed site.
#
# The connect-src host below is the API this build talks to. It is baked into the bundle at build
# time (PUBLIC_API_BASE_URL is an Astro PUBLIC_ variable), so moving the API means changing it in
# two places -- the build environment variable and this line -- or the browser will block every
# call with a CSP violation while the code looks perfectly correct.
#
# That API runs on a home server behind a Cloudflare tunnel rather than on a hosting provider:
# YouTube serves datacenter IPs a bot check that no amount of retrying gets past, and a
# residential IP never sees it.

/*
  # Astro emits two small inline <script> blocks on the island-hydrating page to bootstrap React.
  # Pinning their hashes here would break the site silently on any Astro upgrade or island change,
  # so script-src keeps 'unsafe-inline'. The directive still earns its place: it pins which external
  # hosts may serve script at all, which is what an injected <script src> would need.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://i.ytimg.com; connect-src 'self' https://yt-api.rubenitx.me; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  # Belt and braces with frame-ancestors above, for anything that only understands this one.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Nothing here asks for any of these, so refuse them outright rather than on request.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Astro fingerprints everything under /_astro/, so these are safe to cache forever. The HTML above
# deliberately is not: it is what points at the current fingerprints.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
