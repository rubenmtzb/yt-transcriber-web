---
import { getLangFromPath } from "../../i18n/config";
import { useTranslations } from "../../i18n/ui";

const lang = getLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<main class="content">
  <h1>{t("privacy.title")}</h1>
  <p>{t("privacy.p1")}</p>
  <p>{t("privacy.p2")}</p>
  <p>{t("privacy.p3")}</p>
</main>

<style>
  .content {
    max-width: 640px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  h1 {
    font-size: 2rem;
  }

  p {
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>
