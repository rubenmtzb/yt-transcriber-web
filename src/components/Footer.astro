---
import { getLangFromPath, routes } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const links = [
  { href: routes.howItWorks[lang], label: t("nav.howItWorks") },
  { href: routes.privacy[lang], label: t("nav.privacy") },
];
---

<footer class="footer">
  <p class="notice">{t("footer.notice")}</p>
  <nav class="nav">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
</footer>

<style>
  .footer {
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-5) var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .notice {
    max-width: 480px;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .nav {
    display: flex;
    gap: var(--space-4);
  }

  .nav a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .nav a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .footer {
      padding: var(--space-4) var(--space-3) var(--space-5);
    }
  }
</style>
