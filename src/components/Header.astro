---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { getLangFromPath, routes } from "../i18n/config";
import { useTranslations } from "../i18n/ui";

const lang = getLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);

const links = [
  { href: routes.howItWorks[lang], label: t("nav.howItWorks") },
  { href: routes.privacy[lang], label: t("nav.privacy") },
];
---

<header class="header">
  <a href={routes.home[lang]} class="logo" aria-label={t("nav.home")}>
    <img src="/logo.png" alt="" width="160" height="133" />
  </a>
  <nav class="nav">
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <LanguageSwitcher />
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1080px;
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
  }

  /* Scale lives on the link and the glow on the image: keeping them on separate elements lets the
     transition and the pulsing animation coexist without fighting over the same property. */
  .logo {
    display: flex;
    align-items: center;
    border-radius: var(--radius-md);
    transition: transform 0.25s ease;
  }

  .logo img {
    height: 40px;
    width: auto;
    transition: filter 0.25s ease;
  }

  .logo:hover,
  .logo:focus-visible {
    transform: scale(1.07);
  }

  /* drop-shadow rather than box-shadow so the halo traces the mark itself -- the logo is a
     transparent PNG, and a box-shadow would light up an invisible rectangle around it. */
  .logo:hover img,
  .logo:focus-visible img {
    animation: logo-pulse 1.1s ease-in-out infinite alternate;
  }

  .logo:active {
    transform: scale(0.97);
  }

  @keyframes logo-pulse {
    from {
      filter: drop-shadow(0 0 4px rgba(177, 74, 237, 0.35));
    }
    to {
      filter: drop-shadow(0 0 14px rgba(177, 74, 237, 0.9));
    }
  }

  /* The blanket reduced-motion rule in global.css only collapses the animation's duration, which
     would leave the mark stuck on the first keyframe's faint glow. A static halo says "selected"
     just as clearly without anything moving. */
  @media (prefers-reduced-motion: reduce) {
    .logo:hover img,
    .logo:focus-visible img {
      animation: none;
      filter: drop-shadow(0 0 10px rgba(177, 74, 237, 0.8));
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .nav > a {
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .nav > a:hover {
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .header {
      padding: var(--space-3);
    }

    .nav {
      gap: var(--space-3);
    }
  }
</style>
